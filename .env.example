# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project (existing xlxhikvvckszsyvnodkr project — WatchWell uses its own
# "watchwell" tables/schema inside it, see supabaseClient.js)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
VITE_YOUTUBE_API_KEY=

# PIN for the admin dashboard gate (kid never sees this screen). The on-screen
# keypad is built for a 4-digit numeric PIN, e.g. 2468.
VITE_ADMIN_PIN=

# Kid's first name, shown in the home feed greeting and avatar initial. Optional.
VITE_KID_NAME=
